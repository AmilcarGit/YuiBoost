#!/usr/bin/env bash
# CÓDIGO ORIGINAL DE YUIBOOST
set -uo pipefail

YUI_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export YUI_HOME
YUI_VERSION="1.0.0"

# shellcheck source=config/config.sh
source "$YUI_HOME/config/config.sh"
# shellcheck source=utils/colors.sh
source "$YUI_HOME/utils/colors.sh"
# shellcheck source=utils/logging.sh
source "$YUI_HOME/utils/logging.sh"
# shellcheck source=utils/detection.sh
source "$YUI_HOME/utils/detection.sh"
# shellcheck source=utils/permissions.sh
source "$YUI_HOME/utils/permissions.sh"
# shellcheck source=modules/diagnostics.sh
source "$YUI_HOME/modules/diagnostics.sh"
# shellcheck source=modules/battery.sh
source "$YUI_HOME/modules/battery.sh"
# shellcheck source=modules/temperature.sh
source "$YUI_HOME/modules/temperature.sh"
# shellcheck source=modules/optimize.sh
source "$YUI_HOME/modules/optimize.sh"
# shellcheck source=modules/cleanup.sh
source "$YUI_HOME/modules/cleanup.sh"
# shellcheck source=modules/gaming.sh
source "$YUI_HOME/modules/gaming.sh"
# shellcheck source=modules/benchmark.sh
source "$YUI_HOME/modules/benchmark.sh"
# shellcheck source=core/restore.sh
source "$YUI_HOME/core/restore.sh"
# shellcheck source=core/menu.sh
source "$YUI_HOME/core/menu.sh"

logging_init

print_help() {
    cat <<EOF
🌿 YuiBoost v${YUI_VERSION}
Optimización real para Android/Termux — sin placebos.

Uso:
  ./yui                 Abre el menú interactivo
  ./yui gaming           Ejecuta el modo Gaming directamente
  ./yui optimize          Ejecuta la optimización general
  ./yui cleanup            Ejecuta la limpieza segura
  ./yui diagnostics         Muestra el diagnóstico del dispositivo
  ./yui temperature          Muestra la temperatura
  ./yui battery                Muestra el estado de la batería
  ./yui benchmark                Ejecuta el benchmark antes/después
  ./yui restore                    Restaura los cambios registrados
  ./yui --no-color        Fuerza salida sin colores ANSI
  ./yui --version          Muestra la versión
  ./yui --help               Muestra esta ayuda

YuiBoost no puede aumentar la RAM física, hacer overclock de la GPU/CPU,
garantizar más FPS ni reducir el ping. Consulta el README para más detalle.
EOF
}

main() {
    local cmd=""
    local arg
    for arg in "$@"; do
        case "$arg" in
            --no-color) YUI_NO_COLOR=1; colors_init ;;
            --help|-h) print_help; exit 0 ;;
            --version|-v) printf 'YuiBoost v%s\n' "$YUI_VERSION"; exit 0 ;;
            *) cmd="$arg" ;;
        esac
    done

    case "$cmd" in
        "") menu_loop ;;
        gaming) run_gaming ;;
        optimize) run_optimize ;;
        cleanup) run_cleanup ;;
        diagnostics|diag) run_diagnostics ;;
        temperature|temp) run_temperature ;;
        battery) run_battery ;;
        benchmark) run_benchmark ;;
        restore) run_restore ;;
        *)
            yui_err "Comando desconocido: $cmd"
            print_help
            exit 1
            ;;
    esac
}

main "$@"
